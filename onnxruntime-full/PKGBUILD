# Maintainer: omarchy-onnxruntime contributors
#
# ONNX Runtime built from upstream source at a pinned release, with every
# execution provider this kind of machine can use in one installation: CPU,
# CUDA, TensorRT and OpenVINO (its CPU, Intel GPU and Intel NPU devices).
# Arch's own variants each carry one GPU vendor and no TensorRT or OpenVINO.
#
# ONNX Runtime is MIT-licensed; license=() adds the bundled dependencies
# compiled into its libraries (see there). The CUDA, TensorRT and OpenVINO
# providers link against the vendors' runtimes installed on the machine that
# builds the package; those runtimes are not contained in the package, and
# each engine's licence is its vendor's. Nothing NVIDIA or
# Intel is redistributed by this recipe: the package is built locally from
# the user's own installs (Arch's cuda, cudnn and openvino packages, a
# TensorRT the user installed) and stays on that machine.
#
# AMD GPUs: ROCm and CUDA cannot be combined in one ONNX Runtime build.
# Use Arch's onnxruntime-rocm (or onnxruntime-opt-rocm) instead.
#
# Version: 1.29.0, the release Arch ships, so consumers built against Arch's
# onnxruntime see the same API. It covers the three engines:
#   - CUDA 13.x: CUDA 13 is upstream's main GPU line since 1.27, and Arch
#     builds its own 1.29.0 against extra's cuda 13.4;
#   - TensorRT 11: the provider has NV_TENSORRT_MAJOR >= 11 code paths
#     (precision flags and calibration removed, strongly typed networks);
#   - OpenVINO 2026.x: the provider requires OpenVINO >= 2026.0.
#
# Build-time inputs, each from the environment variable of that name, else
# the default. prepare() checks and prints every value and where it came
# from, and records it for build() and package() (src/ortf.conf), so
# `makepkg --printsrcinfo` and the package metadata never depend on them.
#   ORTF_EPS           execution providers, space- or comma-separated, from
#                      cuda, tensorrt, openvino; or `cpu` alone for a CPU-only
#                      build (default: "cuda tensorrt openvino"). tensorrt
#                      needs cuda. The CPU provider is always built.
#   ORTF_CUDA_ARCHS    CUDA architectures (CMAKE_CUDA_ARCHITECTURES), e.g.
#                      120, sm_120 or "89 120" (default: 120, the RTX 50
#                      series). ONNX Runtime turns a bare number into
#                      machine code for that GPU only (120 -> 120a-real):
#                      the smallest and fastest build, with no PTX to
#                      JIT-compile on another GPU. Add e.g. 120-virtual to
#                      embed PTX as well (one -virtual entry at most).
#                      No a/f suffix: ONNX Runtime adds the a itself, and
#                      turns its SM120 kernels on only for a bare 120.
#   ORTF_NVCC_THREADS  nvcc --threads per CUDA compile job (default: 1).
#   ORTF_TENSORRT_HOME the TensorRT root, holding include/NvInfer.h and
#                      lib/libnvinfer.so (default: /opt/nvidia/tensorrt when
#                      it holds include/NvInfer.h, else /usr).
#   ORTF_PYTHON        1 (default) also builds the Python module for
#                      python-onnxruntime-full; 0 skips it, and makepkg then
#                      stops at python-onnxruntime-full after writing
#                      onnxruntime-full's package.
#   ORTF_CCACHE        auto (default: ccache as the C, C++ and CUDA compiler
#                      launcher when it is on PATH), 1 (required) or 0.
#   MAKEFLAGS          -jN sets the number of parallel compile jobs (ninja
#                      runs nproc+2 without it).
# The Python module is built with the `python` first on PATH (/usr/bin/python
# for a package; anything else is for recipe checks only, and must be the
# system's Python version). It is installed into /usr/bin/python's
# site-packages whichever python builds it.
#
# The build is long and large: hours with CUDA, and it needs tens of GiB of
# disk under the build directory (BUILDDIR=/path/with/space makepkg ... moves
# it; SRCDEST=... moves the 1.6 GiB git clone). CUDA kernels (CUTLASS, flash
# attention) take several GiB of RAM per compile job, so the job count, not
# the thread count, decides whether the build fits in memory. For 24
# threads and 30 GiB of RAM:
#   MAKEFLAGS=-j8 ORTF_NVCC_THREADS=1   (lower to -j6 if the build is
#                                        killed for lack of memory)
# After a failed build, `makepkg -e -f` continues it where it stopped (with
# the inputs prepare() recorded); ccache (on PATH) makes a full rebuild much
# cheaper.
#
# Build (from onnxruntime-full/), e.g.:
#   MAKEFLAGS=-j8 makepkg -f
#   ORTF_TENSORRT_HOME=/usr MAKEFLAGS=-j8 makepkg -f
#   ORTF_EPS=cpu makepkg -d -f        # a CPU-only build to check the recipe
#                                     # (-d: no CUDA, TensorRT or OpenVINO)
# Install the result with:
#   sudo pacman -U onnxruntime-full-*.pkg.tar* python-onnxruntime-full-*.pkg.tar*
#
# It installs /usr/lib/libonnxruntime.so{,.1,.<version>}, one
# /usr/lib/libonnxruntime_providers_<provider>.so per provider built (with
# libonnxruntime_providers_shared.so), the C and C++ API headers in
# /usr/include/onnxruntime/ and /usr/lib/pkgconfig/libonnxruntime.pc. The
# Python package's copies of libonnxruntime.so and the provider libraries
# are links to those in /usr/lib.
#
# TensorRT's built-in plugins (libnvinfer_plugin.so.<major>): ONNX Runtime
# opens that library by name from libonnxruntime.so, which has no RUNPATH,
# so with TensorRT under /opt/nvidia/tensorrt a program that wants them
# runs with that lib/ on LD_LIBRARY_PATH, e.g. by loading
# /usr/share/nvidia-tensorrt/nvidia-tensorrt.env (systemd EnvironmentFile=,
# or `set -a; . file; set +a`). Without it the provider still works and
# logs that the default plugin library was not found.

pkgbase=onnxruntime-full
pkgname=(onnxruntime-full python-onnxruntime-full)
pkgver=1.29.0
pkgrel=1
pkgdesc='Cross-platform inference engine for ONNX models, with the CPU, CUDA, TensorRT and OpenVINO execution providers'
arch=('x86_64')
url='https://github.com/microsoft/onnxruntime'
# ONNX Runtime (MIT) and the bundled dependencies compiled into its
# libraries: abseil, flatbuffers, onnx, dlpack (Apache-2.0); cpuinfo
# (BSD-2-Clause); protobuf, re2, pybind11, CUTLASS (BSD-3-Clause); Boost.Mp11
# (BSL-1.0); Eigen, built MPL2-only (MPL-2.0); date, nlohmann json, GSL,
# SafeInt, cudnn-frontend (MIT). Their notices are in ThirdPartyNotices.txt.
# No vendor runtime is contained (see the top of the file).
license=('MIT AND Apache-2.0 AND BSD-2-Clause AND BSD-3-Clause AND BSL-1.0 AND MPL-2.0')
# Every build input, whatever ORTF_EPS selects. TensorRT is not listed: no
# one package name is provided by both the AUR's tensorrt (under /usr) and
# a local nvidia-tensorrt-sdk package (under /opt/nvidia/tensorrt).
# prepare() checks the TensorRT headers and library when ORTF_EPS has
# tensorrt.
makedepends=(
  'git' 'cmake' 'ninja' 'patchelf'
  'python' 'python-build' 'python-installer' 'python-wheel' 'python-setuptools' 'python-numpy'
  'cuda' 'cudnn'
  'openvino'
)
# !lto: link-time optimisation of the CUDA provider costs hours and many
# GiB of RAM (upstream's releases are not LTO builds); !debug: the CUDA
# provider's debug information alone runs to GiB.
options=('!lto' '!debug')

# The upstream tag and the commit it must point to (checked in prepare()).
_ortf_commit=2e2543fbe9fae542f921d47a72d21d5a4ef0b710

# ONNX Runtime fetches its C++ dependencies with CMake FetchContent, at the
# versions pinned in cmake/deps.txt. They are downloaded here, as makepkg
# sources (checksummed, cached in SRCDEST), and handed to the build as a
# local mirror (onnxruntime_CMAKE_DEPS_MIRROR_DIR): build() needs no network,
# and ONNX Runtime still applies its own patches to them. The system
# packages are not used (FETCHCONTENT_TRY_FIND_PACKAGE_MODE=NEVER): Arch's
# protobuf 36 and abseil-cpp differ from the pinned versions, and mixing
# them is what takes Arch's recipe nine patches. The upstream pins are the
# combination upstream tests; they are linked statically and hidden by the
# libraries' version scripts. prepare() checks each URL and SHA-1 against
# deps.txt, so a version bump that misses one fails there. Not mirrored, as
# this build does not use them: the unit-test, benchmark, XNNPACK, CoreML,
# WebGPU, DirectML, training, telemetry and Arm dependencies, and
# onnx_tensorrt (the TensorRT provider uses TensorRT's own ONNX parser).
_ortf_deps=(
  abseil_cpp re2 protobuf date mp11 json pytorch_cpuinfo microsoft_gsl safeint
  flatbuffers onnx eigen dlpack pybind11 cutlass cudnn_frontend
)
# The git submodules (onnx, libprotobuf-mutator, emsdk) are not checked out:
# onnx comes from deps.txt like the others, the other two are for fuzzing
# and WebAssembly builds.
source=(
  "onnxruntime::git+https://github.com/microsoft/onnxruntime.git#tag=v$pkgver"
  'ortf-dep-abseil_cpp.zip::https://github.com/abseil/abseil-cpp/archive/refs/tags/20250814.0.zip'
  'ortf-dep-re2.zip::https://github.com/google/re2/archive/refs/tags/2024-07-02.zip'
  'ortf-dep-protobuf.zip::https://github.com/protocolbuffers/protobuf/archive/refs/tags/v21.12.zip'
  'ortf-dep-date.zip::https://github.com/HowardHinnant/date/archive/refs/tags/v3.0.1.zip'
  'ortf-dep-mp11.zip::https://github.com/boostorg/mp11/archive/refs/tags/boost-1.82.0.zip'
  'ortf-dep-json.zip::https://github.com/nlohmann/json/archive/refs/tags/v3.11.3.zip'
  'ortf-dep-pytorch_cpuinfo.zip::https://github.com/pytorch/cpuinfo/archive/4628dc060ce4e82345dc166bbac875609db4ff69.zip'
  'ortf-dep-microsoft_gsl.zip::https://github.com/microsoft/GSL/archive/refs/tags/v4.2.1.zip'
  'ortf-dep-safeint.zip::https://github.com/dcleblanc/SafeInt/archive/refs/tags/3.0.28.zip'
  'ortf-dep-flatbuffers.zip::https://github.com/google/flatbuffers/archive/refs/tags/v23.5.26.zip'
  'ortf-dep-onnx.zip::https://github.com/onnx/onnx/archive/refs/tags/v1.22.0.zip'
  'ortf-dep-eigen.zip::https://github.com/eigen-mirror/eigen/archive/1d8b82b0740839c0de7f1242a3585e3390ff5f33/eigen-1d8b82b0740839c0de7f1242a3585e3390ff5f33.zip'
  'ortf-dep-dlpack.zip::https://github.com/dmlc/dlpack/archive/5c210da409e7f1e51ddf445134a4376fdbd70d7d.zip'
  'ortf-dep-pybind11.zip::https://github.com/pybind/pybind11/archive/refs/tags/v3.0.2.zip'
  'ortf-dep-cutlass.zip::https://github.com/NVIDIA/cutlass/archive/refs/tags/v4.4.2.zip'
  'ortf-dep-cudnn_frontend.zip::https://github.com/NVIDIA/cudnn-frontend/archive/refs/tags/v1.24.0.zip'
)
# FetchContent extracts the archives itself.
noextract=("${_ortf_deps[@]/%/.zip}")
noextract=("${noextract[@]/#/ortf-dep-}")
