# Where the vendor installs are looked for (Arch's cuda, cudnn and openvino
# packages; a local TensorRT package). Variables, so that the tests can
# point them at a fixture.
_ortf_cuda_home=/opt/cuda
_ortf_cudnn_home=/usr
_ortf_openvino_cmake_dir=/usr/lib/cmake
_ortf_tensorrt_default=/opt/nvidia/tensorrt
_ortf_cuda_profile=/etc/profile.d/cuda.sh
# The interpreter whose site-packages the Python package installs into.
_ortf_system_python=/usr/bin/python

# Shared libraries of the vendor runtimes. libonnxruntime.so and the Python
# module must need none of them: that is why the vendor runtimes are
# optdepends (package() checks it).
_ortf_vendor_libs='^lib(cuda|cudart|cublas|cublasLt|cufft|curand|cudnn[a-z_]*|nvinfer[a-z_]*|nvonnxparser|openvino[a-z_]*|tbb)[.]so'

# _ortf_pick <name> <default>: sets _ortf_val to the environment variable
# <name> when it is set and not empty, else to <default>, and _ortf_src to
# where the value came from. The caller declares both local.
_ortf_pick() {
  if [[ -n ${!1:-} ]]; then
    _ortf_val=${!1} _ortf_src=environment
  else
    _ortf_val=$2 _ortf_src=default
  fi
}

# _ortf_jobs: prints the job count of -jN, -j N, --jobs=N or --jobs N in
# MAKEFLAGS (the last one wins), nothing when there is none.
_ortf_jobs() {
  local -a words
  local i n=''
  read -ra words <<<"${MAKEFLAGS:-}"
  for ((i = 0; i < ${#words[@]}; i++)); do
    case ${words[i]} in
      -j | --jobs) n=${words[i + 1]:-} ;;
      --jobs=*) n=${words[i]#--jobs=} ;;
      -j*) n=${words[i]#-j} ;;
    esac
  done
  if [[ $n =~ ^[1-9][0-9]*$ ]]; then printf '%s\n' "$n"; fi
  return 0
}

# _ortf_resolve <file>: resolves, checks and prints the build inputs, and
# writes them to <file> as KEY=value lines. Returns 1 with a message on
# stderr when one is not usable.
_ortf_resolve() {
  local out=$1 _ortf_val _ortf_src w
  local -a words lines=()
  local cpu=0 cuda=0 trt=0 ov=0 eps archs='' python=0 python_exe='' nvcc_threads ccache='' jobs
  local trt_home='' trt_libdir='' host_cxx=''

  _ortf_pick ORTF_EPS 'cuda tensorrt openvino'
  read -ra words <<<"${_ortf_val//,/ }"
  if ((${#words[@]} == 0)); then
    echo "ORTF_EPS: empty; give cpu, or some of cuda, tensorrt, openvino" >&2
    return 1
  fi
  for w in "${words[@]}"; do
    case $w in
      cpu) cpu=1 ;;
      cuda) cuda=1 ;;
      tensorrt) trt=1 ;;
      openvino) ov=1 ;;
      *) echo "ORTF_EPS: unknown provider '$w' (known: cpu, cuda, tensorrt, openvino)" >&2; return 1 ;;
    esac
  done
  if ((cpu && cuda + trt + ov > 0)); then
    echo "ORTF_EPS: cpu stands alone (the CPU provider is always built); drop it or the others" >&2
    return 1
  fi
  if ((trt && !cuda)); then
    echo "ORTF_EPS: tensorrt needs cuda" >&2
    return 1
  fi
  eps=''
  ((cpu)) && eps=cpu
  ((cuda)) && eps+=' cuda'
  ((trt)) && eps+=' tensorrt'
  ((ov)) && eps+=' openvino'
  eps=${eps# }
  lines+=("ORTF_EPS=$eps ($_ortf_src)")

  _ortf_pick ORTF_CUDA_ARCHS 120
  read -ra words <<<"${_ortf_val//[,;]/ }"
  local virtual=''
  for w in "${words[@]}"; do
    w=${w#sm_}
    w=${w#sm}
    # ONNX Runtime keeps a bare 120a or 120f as such, and enables its
    # SM120-only kernels only when the list has a bare 120 (its
    # cmake/external/cuda_configuration.cmake and
    # onnxruntime_providers_cuda.cmake): a suffix would silently drop them.
    if [[ $w =~ ^[1-9][0-9]{1,2}[af](-real|-virtual)?$ ]]; then
      echo "ORTF_CUDA_ARCHS: '$w': give ${w%%[af]*} without the a/f suffix (ONNX Runtime adds the a itself: 120 -> 120a-real)" >&2
      return 1
    fi
    if [[ ! $w =~ ^[1-9][0-9]{1,2}(-real|-virtual)?$ ]]; then
      echo "ORTF_CUDA_ARCHS: '$w' is not a CUDA architecture such as 120, sm_120 or 120-virtual" >&2
      return 1
    fi
    # ONNX Runtime keeps only the last -virtual entry.
    if [[ $w == *-virtual ]]; then
      if [[ -n $virtual ]]; then
        echo "ORTF_CUDA_ARCHS: '$virtual' and '$w': ONNX Runtime embeds PTX for one -virtual architecture only" >&2
        return 1
      fi
      virtual=$w
    fi
    archs+=";$w"
  done
  archs=${archs#;}
  if [[ -z $archs ]]; then
    echo "ORTF_CUDA_ARCHS: empty" >&2
    return 1
  fi
  if ((cuda)); then
    lines+=("ORTF_CUDA_ARCHS=$archs ($_ortf_src)")
  else
    lines+=("ORTF_CUDA_ARCHS=$archs ($_ortf_src; unused without cuda)")
  fi

  _ortf_pick ORTF_NVCC_THREADS 1
  if [[ ! $_ortf_val =~ ^[1-9][0-9]*$ ]]; then
    echo "ORTF_NVCC_THREADS: '$_ortf_val' is not a positive number" >&2
    return 1
  fi
  nvcc_threads=$_ortf_val
  lines+=("ORTF_NVCC_THREADS=$nvcc_threads ($_ortf_src)")

  if ((cuda)); then
    if [[ ! -x $_ortf_cuda_home/bin/nvcc ]]; then
      echo "cuda: $_ortf_cuda_home/bin/nvcc not found (install cuda)" >&2
      return 1
    fi
    if [[ ! -f $_ortf_cudnn_home/include/cudnn.h ]]; then
      echo "cuda: $_ortf_cudnn_home/include/cudnn.h not found (install cudnn)" >&2
      return 1
    fi
    # nvcc's host compiler, as the cuda package sets it for login shells.
    if [[ -n ${NVCC_CCBIN:-} ]]; then
      host_cxx=$NVCC_CCBIN _ortf_src=environment
    elif [[ -r $_ortf_cuda_profile ]] &&
      host_cxx=$(sed -n "s/^export NVCC_CCBIN='\([^']*\)'\$/\1/p" "$_ortf_cuda_profile") && [[ -n $host_cxx ]]; then
      _ortf_src=$_ortf_cuda_profile
    else
      host_cxx=/usr/bin/g++ _ortf_src=default
    fi
    lines+=("NVCC_CCBIN=$host_cxx ($_ortf_src; also the C++ compiler)")
  fi

  if ((trt)); then
    _ortf_pick ORTF_TENSORRT_HOME ''
    if [[ -n $_ortf_val ]]; then
      trt_home=$_ortf_val
    elif [[ -f $_ortf_tensorrt_default/include/NvInfer.h ]]; then
      trt_home=$_ortf_tensorrt_default _ortf_src="found $_ortf_tensorrt_default/include/NvInfer.h"
    else
      trt_home=/usr _ortf_src="default: no $_ortf_tensorrt_default/include/NvInfer.h"
    fi
    if [[ $trt_home != /* ]]; then
      echo "ORTF_TENSORRT_HOME: '$trt_home' is not an absolute path" >&2
      return 1
    fi
    trt_home=${trt_home%/}
    [[ -n $trt_home ]] || trt_home=/
    if [[ ! -f $trt_home/include/NvInfer.h ]]; then
      echo "tensorrt: $trt_home/include/NvInfer.h not found (install TensorRT, or set ORTF_TENSORRT_HOME)" >&2
      return 1
    fi
    for w in lib lib64; do
      if compgen -G "$trt_home/$w/libnvinfer.so*" >/dev/null; then
        trt_libdir=$trt_home/$w
        break
      fi
    done
    if [[ -z $trt_libdir ]]; then
      echo "tensorrt: no libnvinfer.so under $trt_home/lib or $trt_home/lib64" >&2
      return 1
    fi
    lines+=("ORTF_TENSORRT_HOME=$trt_home ($_ortf_src; libraries in $trt_libdir)")
  fi

  if ((ov)) && ! compgen -G "$_ortf_openvino_cmake_dir/openvino*/OpenVINOConfig.cmake" >/dev/null; then
    echo "openvino: no $_ortf_openvino_cmake_dir/openvino*/OpenVINOConfig.cmake (install openvino)" >&2
    return 1
  fi

  _ortf_pick ORTF_PYTHON 1
  case $_ortf_val in
    0 | 1) python=$_ortf_val ;;
    *) echo "ORTF_PYTHON: '$_ortf_val' is neither 0 nor 1" >&2; return 1 ;;
  esac
  if ((python)); then
    if ! python_exe=$(command -v python); then
      echo "ORTF_PYTHON=1: no python on PATH" >&2
      return 1
    fi
    lines+=("ORTF_PYTHON=1 ($_ortf_src; $python_exe)")
    [[ $python_exe == /usr/bin/python ]] ||
      lines+=("  warning: $python_exe is not /usr/bin/python: the Python package is for recipe checks only")
  else
    lines+=("ORTF_PYTHON=0 ($_ortf_src; makepkg stops at python-onnxruntime-full)")
  fi

  _ortf_pick ORTF_CCACHE auto
  case $_ortf_val in
    auto) ccache=$(command -v ccache || true) ;;
    1)
      if ! ccache=$(command -v ccache); then
        echo "ORTF_CCACHE=1: ccache is not on PATH" >&2
        return 1
      fi
      ;;
    0) ccache='' ;;
    *) echo "ORTF_CCACHE: '$_ortf_val' is not auto, 0 or 1" >&2; return 1 ;;
  esac
  lines+=("ORTF_CCACHE=$_ortf_val ($_ortf_src; ${ccache:-ccache not used})")

  jobs=$(_ortf_jobs)
  lines+=("jobs=${jobs:-ninja default, nproc+2} (MAKEFLAGS=${MAKEFLAGS:-})")

  printf '  %s\n' "${lines[@]}"
  {
    printf 'ORTF_EPS=%s\n' "$eps"
    printf 'ORTF_CUDA_ARCHS=%s\n' "$archs"
    printf 'ORTF_NVCC_THREADS=%s\n' "$nvcc_threads"
    printf 'ORTF_TENSORRT_HOME=%s\n' "$trt_home"
    printf 'ORTF_TENSORRT_LIBDIR=%s\n' "$trt_libdir"
    printf 'ORTF_PYTHON=%s\n' "$python"
    printf 'ORTF_PYTHON_EXE=%s\n' "$python_exe"
    printf 'ORTF_CCACHE=%s\n' "$ccache"
    printf 'ORTF_JOBS=%s\n' "$jobs"
    printf 'NVCC_CCBIN=%s\n' "$host_cxx"
  } >"$out.tmp" && mv -f -- "$out.tmp" "$out"
}

# _ortf_get <key>: prints the value prepare() recorded for <key>.
_ortf_get() {
  local key value
  while IFS='=' read -r key value; do
    if [[ $key == "$1" ]]; then
      printf '%s\n' "$value"
      return 0
    fi
  done <"$srcdir/ortf.conf"
  echo "ortf.conf: no $1 (run makepkg without -e, so that prepare() runs)" >&2
  return 1
}

# _ortf_has <provider>: whether ORTF_EPS, as recorded, has <provider>.
_ortf_has() {
  local eps
  eps=$(_ortf_get ORTF_EPS) || return 2
  [[ " $eps " == *" $1 "* ]]
}

# _ortf_needed <file>: prints the DT_NEEDED entries of an ELF file.
_ortf_needed() {
  readelf -d -- "$1" | sed -n 's/.*(NEEDED).*\[\(.*\)\]$/\1/p'
}

# _ortf_py_site <python>: prints the site-packages directory for extension
# modules (platlib) of the /usr prefix, as <python> computes it: its own
# version in the path, never its own prefix, so a virtual environment's
# python gives the same directory as /usr/bin/python of that version.
_ortf_py_site() {
  "$1" -I -c 'import sysconfig
print(sysconfig.get_path("platlib", "posix_prefix", {"base": "/usr", "platbase": "/usr"}))'
}

# _ortf_check_tools: the tools the build runs, checked early (makepkg -d
# skips the dependency check).
_ortf_check_tools() {
  local tool missing=() trt_libdir
  local -a tools=(cmake ninja git patch readelf)
  # patchelf only runs for a TensorRT outside the default library path.
  trt_libdir=$(_ortf_get ORTF_TENSORRT_LIBDIR) || return 1
  [[ -z $trt_libdir || $trt_libdir == /usr/lib || $trt_libdir == /usr/lib64 ]] || tools+=(patchelf)
  for tool in "${tools[@]}"; do
    command -v "$tool" >/dev/null || missing+=("$tool")
  done
  if ((${#missing[@]} > 0)); then
    echo "missing tools: ${missing[*]}" >&2
    return 1
  fi
  if [[ $(_ortf_get ORTF_PYTHON) == 1 ]] &&
    ! "$(_ortf_get ORTF_PYTHON_EXE)" -c 'import numpy, build, installer, setuptools, wheel' 2>/dev/null; then
    echo "ORTF_PYTHON=1: the python on PATH lacks numpy, build, installer, setuptools or wheel" >&2
    return 1
  fi
  if [[ $(_ortf_get ORTF_PYTHON) == 1 ]]; then
    # The module is built for the build python's version and installed into
    # the system python's site-packages: they must be the same.
    local build_site system_site
    build_site=$(_ortf_py_site "$(_ortf_get ORTF_PYTHON_EXE)") || return 1
    if ! system_site=$(_ortf_py_site "$_ortf_system_python"); then
      echo "ORTF_PYTHON=1: $_ortf_system_python does not run (install python)" >&2
      return 1
    fi
    if [[ $build_site != "$system_site" ]]; then
      echo "ORTF_PYTHON=1: the python on PATH installs to $build_site, $_ortf_system_python to $system_site: use a python of the system's version" >&2
      return 1
    fi
  fi
}

# _ortf_mirror <deps.txt> <mirror>: lays the downloaded dependency archives
# out as the local mirror ONNX Runtime looks in (<mirror>/<URL without
# https://>), after checking each one's URL and SHA-1 against <deps.txt>.
_ortf_mirror() {
  local deps=$1 mirror=$2 name entry url='' line dep_url dep_sha1 file got
  rm -rf -- "$mirror"
  for name in "${_ortf_deps[@]}"; do
    url=''
    for entry in "${source[@]}"; do
      if [[ $entry == "ortf-dep-$name.zip::"* ]]; then
        url=${entry#*::}
      fi
    done
    if [[ -z $url ]]; then
      echo "source=(): no ortf-dep-$name.zip" >&2
      return 1
    fi
    if ! line=$(grep -m1 "^$name;" -- "$deps"); then
      echo "cmake/deps.txt has no $name: update _ortf_deps and source=()" >&2
      return 1
    fi
    IFS=';' read -r _ dep_url dep_sha1 <<<"$line"
    if [[ $dep_url != "$url" ]]; then
      echo "$name: cmake/deps.txt pins $dep_url, source=() has $url" >&2
      return 1
    fi
    file=$srcdir/ortf-dep-$name.zip
    got=$(sha1sum -- "$file" | cut -d' ' -f1)
    if [[ $got != "$dep_sha1" ]]; then
      echo "$name: SHA-1 $got, cmake/deps.txt expects $dep_sha1" >&2
      return 1
    fi
    install -d -- "$mirror/$(dirname -- "${url#https://}")"
    ln -s -- "$(realpath -- "$file")" "$mirror/${url#https://}"
  done
}

prepare() {
  echo "ONNX Runtime build inputs:"
  _ortf_resolve "$srcdir/ortf.conf" || return 1
  _ortf_check_tools || return 1

  cd "$srcdir/onnxruntime"
  local head
  head=$(git rev-parse HEAD)
  if [[ $head != "$_ortf_commit" ]]; then
    echo "tag v$pkgver is commit $head, not $_ortf_commit: the tag moved; check it and update _ortf_commit" >&2
    return 1
  fi
  # The checkout as tagged: build() copies the Python package tree the
  # build assembled into onnxruntime/ and setup.py leaves build/ and
  # *.egg-info, untracked files that would survive into the next build in
  # this BUILDDIR (makepkg resets tracked files only) and enter its wheel.
  git clean -ffdxq
  _ortf_mirror cmake/deps.txt "$srcdir/deps-mirror" || return 1
  echo "dependency mirror: ${#_ortf_deps[@]} archives checked against cmake/deps.txt"
  # A fresh CMake build directory, so that a cache from other build inputs
  # is never reused (makepkg -e skips prepare() and continues a build).
  rm -rf -- "$srcdir/build" "$srcdir/dist" "$srcdir/stage"
}

build() {
  local jobs ccache python archs host_cxx trt_home
  jobs=$(_ortf_get ORTF_JOBS) || return 1
  ccache=$(_ortf_get ORTF_CCACHE) || return 1
  python=$(_ortf_get ORTF_PYTHON) || return 1

  local -a args=(
    -S "$srcdir/onnxruntime/cmake"
    -B "$srcdir/build"
    -G Ninja
    -Wno-dev
    # Upstream sets COMPILE_WARNING_AS_ERROR on its targets; a newer
    # compiler than upstream's CI must not fail the build on a warning.
    --compile-no-warning-as-error
    # Bundled dependencies declare cmake_minimum_required below 3.5, which
    # CMake 4 refuses.
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5
    # Release adds -O3 -DNDEBUG to makepkg's flags, as upstream builds.
    -DCMAKE_BUILD_TYPE=Release
    -DCMAKE_INSTALL_PREFIX=/usr
    -DCMAKE_INSTALL_LIBDIR=lib
    -Donnxruntime_BUILD_SHARED_LIB=ON
    # The unit tests would build googletest and thousands of test files and
    # need the GPU to mean anything; the package is checked after install.
    -Donnxruntime_BUILD_UNIT_TESTS=OFF
    -DBUILD_TESTING=OFF
    -Donnxruntime_USE_TELEMETRY=OFF
    # The OpenVINO provider requires the full protobuf (build.py turns it
    # on with OpenVINO); used for every build, so that a CPU-only check
    # builds the same configuration.
    -Donnxruntime_USE_FULL_PROTOBUF=ON
    # The pinned dependencies, from the local mirror prepare() laid out.
    -DFETCHCONTENT_TRY_FIND_PACKAGE_MODE=NEVER
    -Donnxruntime_CMAKE_DEPS_MIRROR_DIR="$srcdir/deps-mirror"
  )
  if [[ $python == 1 ]]; then
    args+=(-Donnxruntime_ENABLE_PYTHON=ON -DPython_EXECUTABLE="$(_ortf_get ORTF_PYTHON_EXE)")
  else
    args+=(-Donnxruntime_ENABLE_PYTHON=OFF)
  fi

  # GCC 15 and later reject errors in uninstantiated templates of the
  # bundled abseil and CUTLASS; Arch's recipe downgrades them the same way.
  CXXFLAGS+=' -Wno-template-body'
  # The source paths in __FILE__ (ORT_ENFORCE and the logging macros keep
  # them in the error messages) are written as makepkg writes them for its
  # debug packages, not as the build directory: no reference to $srcdir.
  local prefix_map="-ffile-prefix-map=$srcdir=/usr/src/debug/$pkgbase"
  CFLAGS+=" $prefix_map"
  CXXFLAGS+=" $prefix_map"
  local cc=/usr/bin/gcc cxx=/usr/bin/g++
  if _ortf_has cuda; then
    archs=$(_ortf_get ORTF_CUDA_ARCHS) || return 1
    host_cxx=$(_ortf_get NVCC_CCBIN) || return 1
    # The C++ compiler is nvcc's host compiler, so that host code compiled
    # by nvcc and by the C++ compiler agrees.
    cxx=$host_cxx cc=${host_cxx/g++/gcc}
    # The C++ sources of the CUDA provider include CUDA's CCCL headers.
    CXXFLAGS+=" -I$_ortf_cuda_home/targets/x86_64-linux/include"
    args+=(
      -Donnxruntime_USE_CUDA=ON
      -Donnxruntime_CUDA_HOME="$_ortf_cuda_home"
      -Donnxruntime_CUDNN_HOME="$_ortf_cudnn_home"
      -DCMAKE_CUDA_COMPILER="$_ortf_cuda_home/bin/nvcc"
      -DCMAKE_CUDA_HOST_COMPILER="$host_cxx"
      -DCMAKE_CUDA_ARCHITECTURES="$archs"
      -DCMAKE_CUDA_FLAGS="-Xcompiler -Wno-template-body -Xcompiler $prefix_map"
      -Donnxruntime_NVCC_THREADS="$(_ortf_get ORTF_NVCC_THREADS)"
      # One GPU: no multi-GPU collectives (and no NCCL dependency).
      -Donnxruntime_USE_NCCL=OFF
    )
  fi
  if _ortf_has tensorrt; then
    trt_home=$(_ortf_get ORTF_TENSORRT_HOME) || return 1
    args+=(
      -Donnxruntime_USE_TENSORRT=ON
      -Donnxruntime_TENSORRT_HOME="$trt_home"
      # TensorRT's own libnvonnxparser, which matches the installed
      # TensorRT, rather than a pinned onnx-tensorrt built from source.
      -Donnxruntime_USE_TENSORRT_BUILTIN_PARSER=ON
    )
  fi
  if _ortf_has openvino; then
    # No device is fixed at build time: the provider's device_type option
    # (CPU, GPU, NPU, AUTO:...) picks it per session.
    args+=(-Donnxruntime_USE_OPENVINO=ON)
  fi
  args+=(-DCMAKE_C_COMPILER="$cc" -DCMAKE_CXX_COMPILER="$cxx")
  if [[ -n $ccache ]]; then
    args+=(-DCMAKE_C_COMPILER_LAUNCHER="$ccache" -DCMAKE_CXX_COMPILER_LAUNCHER="$ccache")
    if _ortf_has cuda; then args+=(-DCMAKE_CUDA_COMPILER_LAUNCHER="$ccache"); fi
  fi

  cmake "${args[@]}"
  cmake --build "$srcdir/build" ${jobs:+-j "$jobs"}

  if [[ $python == 1 ]]; then
    # As Arch's recipe does: the Python package tree the build assembled
    # (modules, provider libraries) goes into the source tree, whose
    # setup.py makes the wheel.
    cp -a -- "$srcdir/build/onnxruntime/." "$srcdir/onnxruntime/onnxruntime/"
    rm -rf -- "$srcdir/dist"
    (cd "$srcdir/onnxruntime" &&
      "$(_ortf_get ORTF_PYTHON_EXE)" -m build --wheel --no-isolation --outdir "$srcdir/dist")
  fi
}

package_onnxruntime-full() {
  pkgdesc+=' (C and C++ library)'
  # What libonnxruntime.so itself links (package() checks that it needs no
  # vendor runtime). Each provider library is loaded only when a session
  # asks for its provider, so the vendor runtimes are optional: a missing
  # one disables that provider only. A new CUDA, TensorRT or OpenVINO
  # soname needs a rebuild (pkgrel bump).
  # zlib: the bundled protobuf is built with its gzip streams (as upstream's).
  depends=('glibc' 'libgcc' 'libstdc++' 'zlib')
  optdepends=(
    'nvidia-utils: the NVIDIA driver (CUDA and TensorRT providers)'
    'cuda: CUDA runtime, cuBLAS, cuFFT and cuRAND (CUDA and TensorRT providers)'
    'cudnn: cuDNN (CUDA and TensorRT providers)'
    'tensorrt: TensorRT under /usr, from the AUR (TensorRT provider)'
    'nvidia-tensorrt-sdk: TensorRT under /opt/nvidia/tensorrt, e.g. nvidia-tensorrt-sdk-local from omarchy-nvidia-sdks (TensorRT provider)'
    'openvino: OpenVINO runtime and its CPU device (OpenVINO provider)'
    'openvino-intel-gpu-plugin: the OpenVINO GPU device (Intel graphics)'
    'openvino-intel-npu-plugin: the OpenVINO NPU device (Intel NPU)'
    'intel-compute-runtime: Intel graphics compute runtime (OpenVINO GPU device)'
    'level-zero-loader: oneAPI Level Zero loader (OpenVINO GPU and NPU devices)'
    'intel-npu-driver: Intel NPU user-space driver (OpenVINO NPU device)'
  )
  provides=("onnxruntime=$pkgver" 'libonnxruntime.so')
  conflicts=(onnxruntime onnxruntime-cpu onnxruntime-cuda onnxruntime-opt-cuda
    onnxruntime-rocm onnxruntime-opt-rocm onnxruntime-git)

  local stage=$srcdir/stage lib f left trt_home trt_libdir runpath ep
  rm -rf -- "$stage"
  DESTDIR=$stage cmake --install "$srcdir/build"

  # The library, providers, headers, pkg-config and CMake files only: the
  # bundled dependencies' own install rules (abseil, protobuf, ...) would
  # otherwise put headers and static libraries under /usr that clash with
  # Arch's packages.
  install -d "$pkgdir/usr/lib" "$pkgdir/usr/include"
  cp -a -- "$stage"/usr/lib/libonnxruntime*.so* "$pkgdir/usr/lib/"
  cp -a -- "$stage/usr/include/onnxruntime" "$pkgdir/usr/include/"
  install -Dm644 "$stage/usr/lib/pkgconfig/libonnxruntime.pc" "$pkgdir/usr/lib/pkgconfig/libonnxruntime.pc"
  if [[ -d $stage/usr/lib/cmake/onnxruntime ]]; then
    install -d "$pkgdir/usr/lib/cmake"
    cp -a -- "$stage/usr/lib/cmake/onnxruntime" "$pkgdir/usr/lib/cmake/"
  fi
  left=$(cd "$stage" && find . ! -type d ! -path './usr/lib/libonnxruntime*' \
    ! -path './usr/include/onnxruntime/*' ! -path ./usr/lib/pkgconfig/libonnxruntime.pc \
    ! -path './usr/lib/cmake/onnxruntime/*' | sort)
  if [[ -n $left ]]; then
    echo "not packaged ($(wc -l <<<"$left") files of the bundled dependencies), e.g.:"
    head -n 5 <<<"$left"
  fi

  # The layout consumers rely on.
  local -a expected=(
    usr/lib/libonnxruntime.so usr/lib/libonnxruntime.so.1 "usr/lib/libonnxruntime.so.$pkgver"
    usr/include/onnxruntime/onnxruntime_c_api.h usr/include/onnxruntime/onnxruntime_cxx_api.h
    usr/lib/pkgconfig/libonnxruntime.pc
  )
  if ! _ortf_has cpu; then
    expected+=(usr/lib/libonnxruntime_providers_shared.so)
    for ep in cuda tensorrt openvino; do
      if _ortf_has "$ep"; then expected+=("usr/lib/libonnxruntime_providers_$ep.so"); fi
    done
  fi
  for f in "${expected[@]}"; do
    [[ -e $pkgdir/$f ]] || { echo "the package lacks /$f" >&2; return 1; }
  done

  lib=$pkgdir/usr/lib/libonnxruntime.so.$pkgver
  if _ortf_needed "$lib" | grep -E "$_ortf_vendor_libs"; then
    echo "libonnxruntime.so needs the vendor libraries above: they must become depends" >&2
    return 1
  fi

  # The TensorRT provider finds libnvinfer and libnvonnxparser, which it
  # links, through its own RUNPATH when TensorRT is outside the default
  # library path: no ld.so.conf entry, nothing global. patchelf, after the
  # install, on this one library: CMAKE_INSTALL_RPATH would give every
  # library the path. That RUNPATH does not cover libnvinfer_plugin: the
  # provider has libonnxruntime.so open it by name (Env::LoadDynamicLibrary,
  # tensorrt_execution_provider_custom_ops.cc), and a dlopen() searches the
  # RUNPATH of the object that calls it, which libonnxruntime.so lacks. A
  # program that wants TensorRT's built-in plugins sets LD_LIBRARY_PATH (the
  # top of this file); without them the provider still runs.
  if _ortf_has tensorrt; then
    trt_home=$(_ortf_get ORTF_TENSORRT_HOME)
    trt_libdir=$(_ortf_get ORTF_TENSORRT_LIBDIR)
    lib=$pkgdir/usr/lib/libonnxruntime_providers_tensorrt.so
    if [[ $trt_libdir != /usr/lib && $trt_libdir != /usr/lib64 ]]; then
      patchelf --add-rpath "$trt_libdir" "$lib"
      runpath=$(readelf -d -- "$lib" | sed -n 's/.*(RUNPATH).*\[\(.*\)\]$/\1/p')
      if [[ :$runpath: != *":$trt_libdir:"* ]]; then
        echo "libonnxruntime_providers_tensorrt.so: RUNPATH '$runpath' lacks $trt_libdir" >&2
        return 1
      fi
      echo "libonnxruntime_providers_tensorrt.so: RUNPATH $runpath (TensorRT in $trt_home)"
    fi
  fi
  for lib in "$pkgdir"/usr/lib/libonnxruntime_providers_*.so; do
    [[ -e $lib ]] || continue
    echo "${lib##*/} needs: $(_ortf_needed "$lib" | tr '\n' ' ')"
  done

  install -Dm644 -t "$pkgdir/usr/share/licenses/onnxruntime-full" \
    "$srcdir/onnxruntime/LICENSE" "$srcdir/onnxruntime/ThirdPartyNotices.txt"
}

package_python-onnxruntime-full() {
  pkgdesc+=' (Python module)'
  depends=("onnxruntime-full=$pkgver-$pkgrel" 'glibc' 'libgcc' 'libstdc++' 'zlib'
    'python' 'python-numpy' 'python-flatbuffers' 'python-packaging' 'python-protobuf')
  optdepends=(
    'python-sympy: symbolic shape inference (onnxruntime.tools)'
    'python-psutil: the transformers optimisation and benchmark tools'
    'python-py-cpuinfo: the transformers optimisation and benchmark tools'
  )
  provides=("python-onnxruntime=$pkgver")
  conflicts=(python-onnxruntime python-onnxruntime-cpu python-onnxruntime-cuda
    python-onnxruntime-opt-cuda python-onnxruntime-rocm python-onnxruntime-opt-rocm)

  if [[ $(_ortf_get ORTF_PYTHON) != 1 ]]; then
    echo "built with ORTF_PYTHON=0: there is no Python module to package (onnxruntime-full is done)" >&2
    return 1
  fi
  local python wheels site lib base outside f main=${pkgdir%/*}/onnxruntime-full
  python=$(_ortf_get ORTF_PYTHON_EXE)
  wheels=("$srcdir"/dist/onnxruntime-*.whl)
  if ((${#wheels[@]} != 1)) || [[ ! -f ${wheels[0]} ]]; then
    echo "expected one wheel in $srcdir/dist, found: ${wheels[*]}" >&2
    return 1
  fi
  # The system python's site-packages, whichever python runs the build:
  # installer's own default is the running interpreter's scheme, which for
  # a virtual environment's python is the environment, not /usr.
  # --prefix=/usr gives installer that scheme's paths under /usr (for a
  # venv python too), and prepare() checked that the two pythons agree on
  # the directory.
  site=$(_ortf_py_site "$_ortf_system_python") || return 1
  "$python" -m installer --destdir="$pkgdir" --prefix=/usr "${wheels[0]}"
  outside=$(cd "$pkgdir" && find . -mindepth 1 -maxdepth 1 ! -name usr)
  if [[ -n $outside ]]; then
    echo "the wheel installed outside /usr: $outside" >&2
    return 1
  fi
  if [[ ! -d $pkgdir$site/onnxruntime/capi ]]; then
    echo "the wheel did not install into $site (the system python's site-packages)" >&2
    return 1
  fi
  # installer writes the running interpreter into the scripts' #! line.
  for f in "$pkgdir"/usr/bin/*; do
    if [[ -f $f ]]; then sed -i "1s|^#!.*python[0-9.]*\$|#!$_ortf_system_python|" "$f"; fi
  done
  if [[ $python != "$_ortf_system_python" ]] && grep -rlF -- "${python%/bin/*}" "$pkgdir"; then
    echo "the files above name the build python's environment, ${python%/bin/*}" >&2
    return 1
  fi

  # libonnxruntime.so and the provider libraries are those of
  # onnxruntime-full (the same build, and the TensorRT one with its
  # RUNPATH): links instead of copies.
  for lib in "$pkgdir$site"/onnxruntime/capi/libonnxruntime.so* \
    "$pkgdir$site"/onnxruntime/capi/libonnxruntime_providers_*.so; do
    [[ -e $lib ]] || continue
    base=${lib##*/}
    if [[ ! -f $main/usr/lib/$base ]]; then
      echo "$base is in the wheel but not in onnxruntime-full" >&2
      return 1
    fi
    ln -sf -- "/usr/lib/$base" "$lib"
  done
  for lib in "$pkgdir$site"/onnxruntime/capi/onnxruntime_pybind11_state*.so; do
    [[ -f $lib ]] || { echo "the wheel has no onnxruntime_pybind11_state module" >&2; return 1; }
    if _ortf_needed "$lib" | grep -E "$_ortf_vendor_libs"; then
      echo "${lib##*/} needs the vendor libraries above: they must become depends" >&2
      return 1
    fi
  done

  install -Dm644 -t "$pkgdir/usr/share/licenses/python-onnxruntime-full" \
    "$srcdir/onnxruntime/LICENSE" "$srcdir/onnxruntime/ThirdPartyNotices.txt"
}
